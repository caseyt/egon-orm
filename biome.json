{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!docs/plan",
      "!**/dist",
      "!**/.tsbuild",
      "!**/coverage",
      "!benchmarks/results",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110,
    "lineEnding": "lf"
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test-d.ts", "**/*.itest.ts", "**/test/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["**/*.config.ts", "docs/site/.vitepress/**"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
