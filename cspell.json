{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "files": ["docs/site/**/*.md", "README.md", "CONTRIBUTING.md"],
  "ignorePaths": ["**/node_modules/**", "docs/site/api/reference/**", "docs/site/reference/exports.md"],
  "dictionaryDefinitions": [{ "name": "egon", "path": "./docs/site/words.txt", "addWords": true }],
  "dictionaries": ["egon", "typescript", "node", "softwareTerms", "sql", "npm"],
  "ignoreRegExpList": [
    "/`[^`\\n]*`/g",
    "/^\\s*```[\\s\\S]*?^\\s*```/gm",
    "/<<<.*$/gm",
    "/\\]\\([^)]*\\)/g",
    "/https?:\\/\\/\\S+/g",
    "/\\{#[\\w-]+\\}/g"
  ]
}
